# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Database Configuration
DB_PATH=work.db
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# Administradores do @everyone
# Apenas estas pessoas podem marcar @everyone nos grupos
# Separe os nomes por vírgula
EVERYONE_ADMINS=Pessoa1,Pessoa2,Pessoa3

# WhatsApp Configuration
# OWER_JID é o número do dono do bot no formato internacional (sem o +).
# Exemplo: 551101234567
OWNER_JID=551396540472
# Lista de grupos permitidos (JIDs), obtenha o JID ao adicionar o bot ao grupo e verificar os logs.
GROUP_WHITELIST=120363399389584502,120363322642186322,120362405360135755

# Bot Configuration
TIMEZONE=GMT-3
CACHE_TTL=60m
LOG_LEVEL=INFO
ENABLE_METRICS=false