# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MODEL_BACKUP=gemini-3-flash-preview
GEMINI_MODEL_BACKUP2=gemini-2.5-flash
API_LOGS=false

# Bot Configuration
# Timezone is used for scheduling daily summaries and weekly rankings
TIMEZONE=GMT-3 
CACHE_TTL=60m
LOG_LEVEL=INFO

# Database Configuration
# DB_PATH     — application database managed by the bot (messages, settings, contacts)
# DB_WHATSMEOW_PATH — WhatsApp session database managed exclusively by the whatsmeow library
# Never point both variables to the same file.
DB_PATH=bot.db
DB_WHATSMEOW_PATH=whatsmeow.db
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# Global Bot Admins
# Comma-separated list of extra phone numbers (international format, no '+') 
# that are allowed to use restricted/admin-only bot commands.
# These users will bypass the native WhatsApp group admin check.
# Leave empty to restrict commands to native group admins only.
BOT_ADMINS=

# WhatsApp Logs Configuration
# OWNER_JID is the destination phone number for summary request logs.
# The bot will send a direct message to this number (international format, no '+')
# with details like who requested the summary, the group, size, and personality used.
# Example: 551101234567
OWNER_JID=


# Media Download
# Set to false to disable downloading for each media type
DOWNLOAD_IMAGE=false
DOWNLOAD_VIDEO=false
DOWNLOAD_AUDIO=false
DOWNLOAD_DOCUMENT=false
DOWNLOAD_STICKER=false

# Onboarding Message
# Sent automatically when the bot is added to a new group.
# Use \n for line breaks.
# Supported variables: {daily_status}, {weekly_status}
BOT_ONBOARDING_MESSAGE=👋 *Hello! I am ResumoBOT.*\n\nI have been added to this group and I am ready to summarize conversations with AI!\n\n⚙️ *Group Settings (admins only):*\n• !config — Displays current group settings\n• !setregras <text> — Sets the group rules\n• !addwelcome <msg> — Adds a welcome message (use {numero} to mention who joined)\n• !addfarewell <msg> — Adds a farewell message (use {numero} to mention who left)\n• !delwelcome <n> — Removes a welcome message by index\n• !delfarewell <n> — Removes a farewell message by index\n\n🔔 *Current Status:*\n• Automatic daily summary: {daily_status} (toggle with !resumo)\n• Weekly ranking: {weekly_status} (toggle with !ranking)\n\n📖 *More Info/Help:*\n• !help — Lists all available commands

# Welcome/Farewell messages (global defaults)
# These messages are sent in groups that have not yet configured their own
# custom messages via !addwelcome / !addfarewell.
# Admins of each group can override them with the following commands:
#   !addwelcome <msg>   → adds a welcome message to the group
#   !addfarewell <msg>  → adds a farewell message to the group
#   !delwelcome <n>     → removes a welcome message by index
#   !delfarewell <n>    → removes a farewell message by index
#
# Use {numero} to insert/mention all members affected by the event and {regras} to insert the group rules.
# Separate multiple messages with | to choose one randomly for each event. \n can be used for line breaks.
# Leave empty to disable globally (enabled by default if filled).
WELCOME_MESSAGES=Welcome, {numero}! Check the group rules:\n{regras}
FAREWELL_MESSAGES={numero} left the group!

# Group rules (global default)
# Displayed by the !regras command in groups without specific rules defined in the database.
# Admins of each group can define specific rules using !setregras <text>.
# Use \n for line breaks. Leave empty to disable the !regras command globally.
GROUP_RULES=