# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MODEL_BACKUP=gemini-3-flash-preview
GEMINI_MODEL_BACKUP2=gemini-2.5-flash

# Database Configuration
DB_PATH=work.db
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# Administradores do @everyone
# Por padrão, apenas admins nativos do grupo WhatsApp podem usar @everyone.
# Use este campo para adicionar JIDs extras (número internacional sem o +)
# que também terão permissão, mesmo que não sejam admins do grupo.
# Separe por vírgula. Deixe vazio para usar apenas admins nativos do grupo.
EVERYONE_ADMINS=

# WhatsApp Configuration
# OWER_JID é o número do dono do bot no formato internacional (sem o +).
# Exemplo: 551101234567
OWNER_JID=551396540472
# Lista de grupos permitidos (JIDs), obtenha o JID ao adicionar o bot ao grupo e verificar os logs.
GROUP_WHITELIST=120363399389584502,120363322642186322,120362405360135755

# Bot Configuration
TIMEZONE=GMT-3
CACHE_TTL=60m
LOG_LEVEL=INFO
ENABLE_METRICS=false

# Mensagens automáticas de entrada/saída de membros (somente grupos da whitelist)
# Para desativar um tipo, deixe a respectiva mensagem vazia
# Use @numero para inserir/mentionar todos os membros afetados no evento
# Separe múltiplas mensagens com | para que uma seja escolhida aleatoriamente a cada evento
# Exemplo de uma só mensagem: "Boas-vindas, @numero!"
# Exemplo com pool: "Boas-vindas, @numero!|Olá, @numero! Seja bem-vindo(a)!"
# Se nenhuma mensagem contiver @numero, ela será enviada como texto cru (sem menções)
WELCOME_MESSAGES=Seja bem-vindo(a), @numero!|Olá @numero! Seja bem-vindo(a)! 🎉\nLeia nossas regras: {regras}
FAREWELL_MESSAGES=@numero saiu do grupo.|Até mais, @numero! 👋

# Regras do grupo (exibidas pelo comando !regras e referênciasáveis via {regras} nas msgs de boas-vindas/despedida)
# Use \n para quebras de linha dentro do valor do .env
# Deixe vazio para desativar o comando !regras
# Exemplo de uso em boas-vindas: "Olá @numero! Leia as regras: {regras}"
GROUP_RULES=

# Media Download Configuration
# Defina como false para desabilitar o download de cada tipo de mídia
# Padrão: true (download habilitado para todos os tipos)
DOWNLOAD_IMAGE=true
DOWNLOAD_VIDEO=true
DOWNLOAD_AUDIO=true
DOWNLOAD_DOCUMENT=true
DOWNLOAD_STICKER=true

# Resumo semanal de mensagens
# Toda segunda-feira às 12:00 (horário local) o bot envia automaticamente um ranking
# de quem mais enviou mensagens de segunda a domingo da semana anterior.
# Os grupos que recebem o ranking são os mesmos definidos em GROUP_WHITELIST.
# Não é necessária nenhuma configuração adicional.
