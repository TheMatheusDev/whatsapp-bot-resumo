# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MODEL_BACKUP=gemini-3-flash-preview
GEMINI_MODEL_BACKUP2=gemini-2.5-flash
API_LOGS=false

# Database Configuration
DB_PATH=work.db
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# Administradores do @everyone
# Por padrão, apenas admins nativos do grupo WhatsApp podem usar @everyone.
# Use este campo para adicionar JIDs extras (número internacional sem o +)
# que também terão permissão, mesmo que não sejam admins do grupo.
# Separe por vírgula. Deixe vazio para usar apenas admins nativos do grupo.
EVERYONE_ADMINS=

# WhatsApp Configuration
# OWNER_JID é o número do dono do bot no formato internacional (sem o +).
# Exemplo: 551101234567
OWNER_JID=

# Bot Configuration
TIMEZONE=GMT-3
CACHE_TTL=60m
LOG_LEVEL=INFO
ENABLE_METRICS=false

# ─── Media Download ────────────────────────────────────────────────────────────
# Defina como false para desabilitar o download de cada tipo de mídia
DOWNLOAD_IMAGE=false
DOWNLOAD_VIDEO=false
DOWNLOAD_AUDIO=false
DOWNLOAD_DOCUMENT=false
DOWNLOAD_STICKER=false

# --- Onboarding Message
# Mensagem enviada ao grupo após o bot ser adicionado, explicando suas funcionalidades básicas e comandos principais.
BOT_ONBOARDING_MESSAGE=

# ─── Mensagens de entrada/saída (defaults globais) ────────────────────────────
# Estas mensagens são enviadas em grupos que ainda não configuraram mensagens
# próprias via !addwelcome / !addfarewell.
# Admins de cada grupo podem substituí-las com os comandos:
#   !addwelcome <msg>   → adiciona mensagem de boas-vindas ao grupo
#   !addfarewell <msg>  → adiciona mensagem de despedida ao grupo
#   !delwelcome <n>     → remove mensagem de boas-vindas pelo índice
#   !delfarewell <n>    → remove mensagem de despedida pelo índice
#
# Use {numero} para inserir/mencionar todos os membros afetados no evento.
# A sintaxe legada @numero também é suportada.
# Separe múltiplas mensagens com | para sortear aleatoriamente a cada evento.
# Deixe vazio para desativar globalmente (por padrão ativo se preenchido).
WELCOME_MESSAGES=Seja bem-vindo(a), {numero}!
FAREWELL_MESSAGES={numero} saiu do grupo!

# ─── Regras do grupo (default global) ─────────────────────────────────────────
# Exibidas pelo comando !regras em grupos sem regras definidas no banco de dados.
# Admins de cada grupo podem definir regras específicas com !setregras <texto>.
# Use \n para quebras de linha. Deixe vazio para desativar o comando !regras globalmente.
GROUP_RULES=

# ─── Media Download ────────────────────────────────────────────────────────────
# Defina como false para desabilitar o download de cada tipo de mídia
DOWNLOAD_IMAGE=true
DOWNLOAD_VIDEO=true
DOWNLOAD_AUDIO=true
DOWNLOAD_DOCUMENT=true
DOWNLOAD_STICKER=true
