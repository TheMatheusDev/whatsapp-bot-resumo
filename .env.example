# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_BACKUP=gemini-flash-latest

# Database Configuration
DB_PATH=work.db
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# WhatsApp Configuration
OWNER_JID=your_phone_number_here
USER_WHITELIST=number1,number2,number3
GROUP_WHITELIST=group1,group2
USER_BLACKLIST=
GROUP_BLACKLIST=
EVERYONE_ADMINS=Lucas, John Kleber, Jane Doe

# Bot Configuration
TIMEZONE=GMT-3
CACHE_TTL=10m
LOG_LEVEL=INFO
ENABLE_METRICS=false